{
  "name": "hiroshi",
  "version": "0.1.0",
  "description": "Multi-Agent Orchestration Cockpit rendered on the GPU with GPUIX",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot app.tsx",
    "build": "bun build --compile app.tsx --outfile dist/hiroshi",
    "web:dev": "bun web.ts",
    "screenshot": "bun screenshot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gpuix/react": "^0.11.0",
    "@types/mdast": "^4.0.4",
    "react": "^19.2.4",
    "safe-mdx": "1.14.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
